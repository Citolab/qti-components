<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
      identifier="item-10" title="Wat weet ik nog? – Fotosynthese 10" adaptive="false"
      time-dependent="false" xml:lang="nl">
      <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
            <qti-correct-response>
                  <qti-value>D</qti-value>
            </qti-correct-response>
      </qti-response-declaration>
      <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
            <qti-default-value>
                  <qti-value>0</qti-value>
            </qti-default-value>
      </qti-outcome-declaration>
      <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
            <qti-default-value>
                  <qti-value>1</qti-value>
            </qti-default-value>
      </qti-outcome-declaration>
      <qti-stylesheet href="../styles/item-layout.css" type="text/css" />
      <qti-item-body>
            <p> Hieronder is een witlof getekend. </p>
            <div class="dep-dialogTrigger" data-stimulus-idref="WIN_item-10-image-2">
                  <img src="../assets/item-10-image-2.png" width="115"
                        alt="Afbeelding met schets, Lijnillustraties, lijntekening, Kleurboek  Door AI gegenereerde inhoud is mogelijk onjuist." />
            </div>
            <div id="WIN_item-10-image-2" class="dep-dialog hide-dialog"
                  data-dep-dialog-caption="Afbeelding 2"
                  data-dep-dialog-resizemode="auto"
                  data-dep-dialog-modal="true">
                  <img src="../assets/item-10-image-2.png" width="306"
                        alt="Afbeelding met schets, Lijnillustraties, lijntekening, Kleurboek  Door AI gegenereerde inhoud is mogelijk onjuist." />
            </div>
            <qti-choice-interaction max-choices="1"
                  response-identifier="RESPONSE" data-score="1">
                  <qti-prompt>
                        <p> In welke delen van de witlof kan fotosynthese plaatsvinden? </p>
                  </qti-prompt>
                  <qti-simple-choice identifier="A">
                        <p> Bladeren. </p>
                  </qti-simple-choice>
                  <qti-simple-choice identifier="B">
                        <p> Wortels. </p>
                  </qti-simple-choice>
                  <qti-simple-choice identifier="C">
                        <p> Stengels. </p>
                  </qti-simple-choice>
                  <qti-simple-choice identifier="D">
                        <p> Geen enkel deel. </p>
                  </qti-simple-choice>
            </qti-choice-interaction>
      </qti-item-body>
      <qti-response-processing
            template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct" />
</qti-assessment-item>