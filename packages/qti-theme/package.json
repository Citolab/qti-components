{
  "name": "@qti-components/theme",
  "description": "QTI theme utilities",
  "version": "1.5.0",
  "author": "",
  "exports": {
    "./item.css": "./dist/item.css",
    "./native.css": "./dist/native.css",
    "./minimal.css": "./dist/minimal.css",
    "./kennisnet-override.css": "./dist/kennisnet-override.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "qti",
    "theme"
  ],
  "license": "GPL-3.0-only",
  "scripts": {
    "attw": "attw --profile esm-only --pack",
    "build": "postcss ./src/item.css -d dist -m && postcss ./src/native.css -d dist -m && postcss ./src/minimal.css -d dist -m && sass --no-source-map ./src/kennisnet-override.scss ./dist/kennisnet-override.css",
    "clean": "rm -rf dist",
    "yalc": "yalc publish",
    "yalc:push": "yalc push",
    "publish": "node ../../tools/publish-if-needed.mjs"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/qti-components.git",
    "directory": "packages/qti-theme"
  },
  "devDependencies": {
    "sass": "^1.101.0"
  }
}
