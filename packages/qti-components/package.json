{
  "name": "@citolab/qti-components",
  "description": "QTI component utilities",
  "version": "8.0.2",
  "author": "",
  "dependencies": {
    "@heximal/templates": "^0.1.5",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@qti-components/base": "workspace:^",
    "@qti-components/corrections": "workspace:^",
    "@qti-components/elements": "workspace:^",
    "@qti-components/interactions": "workspace:^",
    "@qti-components/item": "workspace:^",
    "@qti-components/loader": "workspace:^",
    "@qti-components/processing": "workspace:^",
    "@qti-components/test": "workspace:^",
    "@qti-components/theme": "workspace:^",
    "@qti-components/transformers": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./qti-base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./qti-elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./qti-processing": {
      "types": "./dist/processing.d.ts",
      "import": "./dist/processing.js"
    },
    "./qti-interactions": {
      "types": "./dist/interactions.d.ts",
      "import": "./dist/interactions.js"
    },
    "./qti-item": {
      "types": "./dist/item.d.ts",
      "import": "./dist/item.js"
    },
    "./qti-test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    },
    "./qti-loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./corrections": {
      "types": "./dist/corrections.d.ts",
      "import": "./dist/corrections.js"
    },
    "./qti-transformers": {
      "types": "./dist/transformers.d.ts",
      "import": "./dist/transformers.js"
    },
    "./item.css": "./dist/item.css",
    "./cdn/*": "./cdn/*",
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/qti-components-jsx.d.ts",
      "default": "./dist/qti-components-jsx.js"
    }
  },
  "files": [
    "dist",
    "cdn"
  ],
  "keywords": [
    "components",
    "qti"
  ],
  "license": "GPL-3.0-only",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/qti-components.git",
    "directory": "packages/qti-components"
  },
  "scripts": {
    "-": "---build---",
    "attw": "attw --pack --profile esm-only --format table",
    "build": "run-s cem:react-types cem:react-types:patch-ref build:bundle",
    "build:bundle": "run-p tsup css",
    "cem:react-types": "CEM_OUTDIR=packages/qti-components/ pnpm -C ../.. run cem:core && node -e \"require('fs').writeFileSync('dist/qti-components-jsx.js','export {};\\n')\"",
    "cem:react-types:patch-ref": "node ../../tools/build/patch-jsx-react-ref.mjs dist/qti-components-jsx.d.ts",
    "clean": "rm -rf dist cdn",
    "css": "postcss ../qti-theme/src/item.css -d dist -m",
    "publint": "publint",
    "tsup": "NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "yalc": "yalc publish",
    "yalc:push": "yalc push",
    "deploy": "cd ../interactions/core && pnpm run build && cd ../../qti-components && pnpm run build && yalc push",
    "publish": "node ../../tools/publish-if-needed.mjs"
  },
  "sideEffects": true,
  "type": "module"
}
