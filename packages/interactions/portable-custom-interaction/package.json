{
  "name": "@qti-components/portable-custom-interaction",
  "description": "QTI portable-custom-interaction interaction",
  "version": "1.3.1",
  "author": "",
  "dependencies": {
    "@qti-components/base": "workspace:^",
    "@qti-components/interactions-core": "workspace:^",
    "@qti-components/theme": "workspace:^",
    "@qti-components/utilities": "workspace:^"
  },
  "devDependencies": {
    "@lit/context": "catalog:",
    "lit": "catalog:",
    "requirejs": "2.3.8"
  },
  "keywords": [
    "interactions",
    "qti",
    "portable-custom-interaction"
  ],
  "license": "GPL-3.0-only",
  "main": "dist/index.js",
  "peerDependencies": {
    "@lit/context": "catalog:",
    "lit": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "attw": "attw --profile esm-only --pack",
    "build": "pnpm run clean && tsc --paths null",
    "clean": "rm -rf dist",
    "vendor:requirejs": "node ../../../tools/build/vendor-requirejs.mjs",
    "yalc": "yalc publish",
    "yalc:push": "yalc push"
  },
  "sideEffects": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./*": "./dist/*",
    "./styles": {
      "types": "./dist/qti-portable-custom-interaction.styles.d.ts",
      "import": "./dist/qti-portable-custom-interaction.styles.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/qti-components.git",
    "directory": "packages/interactions/portable-custom-interaction"
  }
}
