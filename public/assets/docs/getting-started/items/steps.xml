<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item
  xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="GS-steps" title="The steps" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="ordered" base-type="identifier">
    <qti-correct-response>
      <qti-value>light</qti-value>
      <qti-value>split</qti-value>
      <qti-value>sugar</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float" />
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value><qti-value>1</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <div class="qti-layout-row">
      <div class="qti-layout-col6">
        <h2>The steps</h2>
        <p>
          First the leaf <strong>absorbs light</strong>. That energy <em>splits water</em>. Finally the plant
          <strong>builds sugar</strong> from carbon dioxide.
        </p>
      </div>
      <div class="qti-layout-col6">
        <qti-order-interaction response-identifier="RESPONSE" shuffle="true">
          <qti-prompt>Put the steps in order.</qti-prompt>
          <qti-simple-choice identifier="light">The leaf absorbs light</qti-simple-choice>
          <qti-simple-choice identifier="split">Water is split</qti-simple-choice>
          <qti-simple-choice identifier="sugar">Sugar is built</qti-simple-choice>
        </qti-order-interaction>
      </div>
    </div>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml" />
</qti-assessment-item>
