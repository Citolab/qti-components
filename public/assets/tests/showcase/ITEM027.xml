<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<qti-assessment-item xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
                     xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
                     identifier="ITEM027"
                     title="Custom interaction (PCI)"
                     time-dependent="false"
                     xml:lang="en-GB">
    <qti-response-declaration identifier="RESPONSE" base-type="integer" cardinality="single">
        <qti-correct-response>
            <qti-value>6</qti-value>
        </qti-correct-response>
    </qti-response-declaration>

    <qti-outcome-declaration identifier="SCORE" base-type="float" cardinality="single" normal-minimum="0" normal-maximum="1">
        <qti-default-value>
            <qti-value>0</qti-value>
        </qti-default-value>
    </qti-outcome-declaration>
    <qti-outcome-declaration identifier="MAXSCORE" base-type="float" cardinality="single">
        <qti-default-value>
            <qti-value>1</qti-value>
        </qti-default-value>
    </qti-outcome-declaration>

    <qti-item-body>
        <p>Shade <strong>¾</strong> of the bar. Click a part to shade it; click it again to clear it.</p>
        <qti-portable-custom-interaction response-identifier="RESPONSE"
                                         module="fraction-bar"
                                         custom-interaction-type-identifier="urn:cito:pci:showcase:fraction-bar"
                                         data-parts="8"
                                         data-label="Bar of eight equal parts">
            <qti-interaction-modules>
                <qti-interaction-module id="fraction-bar" primary-path="modules/fraction-bar.js"/>
            </qti-interaction-modules>
            <qti-interaction-markup/>
        </qti-portable-custom-interaction>

        <qti-rubric-block view="scorer" use="scoring">
            <qti-content-body>
                <p>Correct: six of the eight parts shaded (¾ = 6⁄8). Which parts are shaded does not matter.</p>
            </qti-content-body>
        </qti-rubric-block>
    </qti-item-body>

    <qti-response-processing>
        <qti-response-condition>
            <qti-response-if>
                <qti-match>
                    <qti-variable identifier="RESPONSE"/>
                    <qti-correct identifier="RESPONSE"/>
                </qti-match>
                <qti-set-outcome-value identifier="SCORE">
                    <qti-base-value base-type="float">1</qti-base-value>
                </qti-set-outcome-value>
            </qti-response-if>
        </qti-response-condition>
    </qti-response-processing>
</qti-assessment-item>
