#!/bin/bash
set -e

# Not in CI. Everything below gates a HUMAN commit; none of it has a subject when the committer is
# a robot. The release workflow commits the changesets version bump itself, and that commit would
# otherwise fire this hook — running a browser VRT pass in a job that installs no Playwright
# browsers and has no reason to.
#
# The same omission was not hypothetical in qti-editor: it failed a release outright, which then
# published nothing while main sat several merges ahead of npm. Guarding both hooks the same way.
if [ -n "$CI" ]; then
  exit 0
fi

# Visual-regression gate, first. The committed VRT baselines must still match, so a stray visual
# change can't slip through unnoticed. Compare-only (never --update): a browser run of a handful of
# stories, a few seconds. If this fails on an INTENTIONAL visual change, refresh the baselines with
# `pnpm test:vrt:update` and stage them, then commit again.
echo "→ Checking VRT screenshots…"
pnpm run test:vrt

# One tier, same on every branch. Fast by design — heavier verification
# (attw, madge, publint, full test suite) is the CI gate's job, not the commit's.
#
# lint-staged runs on STAGED files only — prettier, eslint, stylelint, and one
# `vitest run --changed` for the whole commit. See .lintstagedrc.mjs; the comment
# there explains why the test call has to stay inside lint-staged rather than move
# up here, and why it is `--changed` rather than `related`.
#
# --hide-unstaged is load-bearing, not a tidiness flag. By default lint-staged hides only
# PARTIALLY staged files, so a fully unstaged edit stays in the working tree and
# `vitest --changed` picks it up — which means an unstaged fix can make a staged bug pass and
# the commit goes out green. With this flag every unstaged change is stashed for the run, so
# "changed" and "staged" are the same set. Restorable either way: git stash list.
npx lint-staged --allow-empty --quiet --hide-unstaged

# Keep the committed custom-elements.json manifests in sync with source.
# `cem` (analyzer) is much cheaper than a full `pnpm run build`.
pnpm run cem
git add \
  custom-elements.json \
  packages/qti-interactions/custom-elements.qti.json
