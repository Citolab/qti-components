From a6a75818c529bbae965fedc44200c31633fd9e78 Mon Sep 17 00:00:00 2001
From: qti-components-migration <migration@local>
Date: Fri, 9 Oct 2026 17:29:27 +0200
Subject: [PATCH 3/6] qti: type the test config as ConfigContext &
 CorrectionConfig; disableAfterMaxReached

correctResponseMode and fullCorrectResponseOnlyWhenIncorrect moved to CorrectionConfig in 8.0. disableAfterIfMaxChoicesReached is deprecated (still works, warns once).
---
 projects/shared/src/lib/qti/qti-test.ts | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/projects/shared/src/lib/qti/qti-test.ts b/projects/shared/src/lib/qti/qti-test.ts
index ede05d1..7bac332 100644
--- a/projects/shared/src/lib/qti/qti-test.ts
+++ b/projects/shared/src/lib/qti/qti-test.ts
@@ -2,6 +2,7 @@
 import { AfterViewInit, ChangeDetectorRef, Directive, effect, ElementRef, inject, input, OnDestroy, output, signal } from '@angular/core';
 import { EventNames, QtiEvent } from './events';
 import { IQtiTest } from '@kennisnet/qti-components';
+import type { ConfigContext, CorrectionConfig } from '@kennisnet/qti-components';
 import { PlayMode, store, ViewMode } from '../player';
 
 @Directive({
@@ -70,8 +71,10 @@ export class QtiTestDirective implements AfterViewInit, OnDestroy {
     if (this.stopped) return;
     const el = this.host.nativeElement;
     if (el.shadowRoot) {
-      el.configContext = {
-        disableAfterIfMaxChoicesReached: true,
+      // correctResponseMode and fullCorrectResponseOnlyWhenIncorrect belong to the corrections
+      // package (CorrectionConfig) since 8.0; the library still reads them from configContext.
+      const config: ConfigContext & CorrectionConfig = {
+        disableAfterMaxReached: true,
         correctResponseMode: 'full',
         inlineChoicePrompt: 'selecteer',
         // Preview always reveals every model answer (teachers review the whole key); in formative /
@@ -81,6 +84,7 @@ export class QtiTestDirective implements AfterViewInit, OnDestroy {
         // test, which expects 2 clones for a 3-gap item where one gap was answered correctly.)
         fullCorrectResponseOnlyWhenIncorrect: store.state().mode !== PlayMode.Preview,
       };
+      el.configContext = config;
       this.observe(el.shadowRoot);
     } else {
       requestAnimationFrame(() => this.waitForShadowRoot());
-- 
