{
  "name": "qti-components-workspace",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/qti-components.git"
  },
  "description": "QTI webcomponents",
  "author": {
    "name": "Patrick de Klein"
  },
  "type": "module",
  "contributors": [
    {
      "name": "Sander Looise"
    },
    {
      "name": "Marcel Hoekstra"
    },
    {
      "name": "Denise Broekman"
    }
  ],
  "license": "GPLv3",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "local:workspace-publish:force": "pnpm run build && pnpm -r --filter \"./packages/*\" --filter \"./packages/interactions/*\" --filter \"!./packages/qti-components\" --workspace-concurrency=1 publish --access public --ignore-scripts --no-git-checks",
    "ci:push-quality": "run-s lint madge build test publint attw consumer-types",
    "storybook": "run-p storybook:dev cem:storybook:watch",
    "lint": "eslint && pnpm run lint:css && pnpm run lint:vocab",
    "test": "node tools/testing/pretest-clean.mjs && pnpm run build && vitest run",
    "test:vrt": "VRT=1 vitest run --project vrt",
    "test:vrt:update": "VRT=1 vitest run --project vrt --update",
    "test:vrt:ui": "VRT=1 vitest --project vrt --ui",
    "tsc": "tsc --noEmit",
    "clean": "pnpm -r run clean",
    "cem": "run-s cem:qti cem:core",
    "cem:core": "custom-elements-manifest analyze --config cem.config.mjs",
    "cem:qti": "pnpm --filter @qti-components/interactions run cem:qti",
    "build": "pnpm -r run build",
    "attw": "env NPM_CONFIG_CACHE=/tmp/qti-components-npm-cache pnpm -r run attw",
    "consumer-types": "node tools/testing/consumer-types.mjs",
    "publint": "pnpm -r run publint",
    "yalc": "pnpm -r run yalc",
    "yalc:push": "pnpm -r run yalc:push",
    "watch": "pnpm --filter \"./packages/qti-components\" --filter \"./packages/qti-interactions\" --filter \"./packages/qti-theme\" --filter \"./packages/interactions/*\" --parallel exec -- nodemon --watch src --ext ts,css --exec \"pnpm run build && pnpm run yalc:push\"",
    "commit-msg": "commitlint --edit",
    "build-storybook": "pnpm run cem && storybook build",
    "storybook:dev": "storybook dev -p 6006 --no-open",
    "storybook:stackblitz": "pnpm run storybook:dev",
    "cem:storybook:watch": "custom-elements-manifest analyze --watch --config cem.config.mjs",
    "css": "postcss packages/qti-theme/src/item.css -d dist -m",
    "chromatic": "node chromatic-runner.cjs",
    "madge": "madge packages/**/src --extensions ts,tsx,js --circular --ts-config tsconfig.json",
    "deps:lint": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "deps:format:check": "syncpack format --check",
    "deps:check": "manypkg check",
    "deps:fix:manypkg": "manypkg fix",
    "pm:check": "sherif",
    "preinstall": "sherif",
    "prepare": "husky",
    "changeset": "pnpm dlx @changesets/cli",
    "changeset:status": "pnpm dlx @changesets/cli status",
    "changeset:version": "pnpm dlx @changesets/cli version",
    "changeset:publish": "pnpm dlx @changesets/cli publish",
    "changeset:tag": "node tools/changesets/tag-published.mjs",
    "changeset:check-umbrella": "node tools/changesets/check-umbrella-bump.mjs",
    "ci:release:changesets:dry": "pnpm run changeset:status",
    "ci:release:changesets": "pnpm run changeset:version && pnpm run build && pnpm run changeset:publish",
    "ci:publish:workspace": "PNPM_GIT_CHECKS=false pnpm -r --filter \"./packages/*\" --filter \"./packages/interactions/*\" --filter \"!./packages/qti-components\" run publish",
    "ci:publish:umbrella": "PNPM_GIT_CHECKS=false pnpm --filter \"./packages/qti-components\" run publish",
    "ci:publish:missing": "run-s ci:publish:workspace ci:publish:umbrella",
    "lint:css": "stylelint \"packages/**/src/**/*.{css,scss}\"",
    "lint:vocab": "node tools/qti-vocabulary/check.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/get-release-plan": "^5.0.0",
    "@chromatic-com/storybook": "^5.3.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@custom-elements-manifest/analyzer": "^0.10.10",
    "@eslint/js": "^9.39.2",
    "@manypkg/cli": "^0.25.1",
    "@open-wc/lit-helpers": "^0.7.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@swc/core": "^1.15.11",
    "@testing-library/dom": "^10.4.1",
    "@types/dom-view-transitions": "^1.0.6",
    "@types/node": "^24.10.9",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@wc-toolkit/cem-inheritance": "^1.2.2",
    "@wc-toolkit/cem-sorter": "^1.0.1",
    "@wc-toolkit/cem-utilities": "^1.5.4",
    "@wc-toolkit/cem-validator": "^1.3.0",
    "@wc-toolkit/changelog": "^1.0.2",
    "@wc-toolkit/jsx-types": "^1.5.2",
    "@wc-toolkit/storybook-helpers": "^10.7.7",
    "@wc-toolkit/type-parser": "^1.2.0",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.10.43",
    "chromatic": "^13.3.5",
    "custom-element-vs-code-integration": "^1.5.0",
    "custom-elements-manifest-deprecator": "^1.2.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-wc": "^3.0.2",
    "fast-xml-parser": "^5.5.7",
    "globals": "^16.5.0",
    "globby": "^14.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "madge": "^8.0.0",
    "mdx-mermaid": "^2.0.4",
    "mermaid": "^11.12.2",
    "modern-normalize": "^3.0.1",
    "msw": "^2.12.7",
    "msw-storybook-addon": "^3.0.0",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "path-browserify": "^1.0.1",
    "pkg-pr-new": "^0.0.51",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nesting": "^13.0.2",
    "postcss-scss": "^4.0.9",
    "prettier": "3.5.3",
    "prettier-v2": "npm:prettier@2.8.8",
    "publint": "^0.3.17",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "shadow-dom-testing-library": "^1.13.1",
    "sherif": "^1.10.0",
    "storybook": "^10.5.10",
    "storybook-addon-tag-badges": "^3.1.0",
    "stylelint": "^17.14.0",
    "syncpack": "14.0.0-alpha.40",
    "ts-morph": "^27.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10",
    "yalc": "1.0.0-pre.53"
  },
  "bugs": {
    "url": "https://github.com/Citolab/qti-components/issues"
  },
  "homepage": "https://github.com/Citolab/qti-components#readme",
  "overrides": {
    "storybook": "$storybook",
    "basic-ftp": "^5.3.1"
  },
  "pnpm": {
    "overrides": {
      "caniuse-lite": "1.0.30001805",
      "basic-ftp": "^5.3.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "rollup@<4.59.0": "4.59.0",
      "ajv@>=8.0.0 <8.18.0": "8.18.0",
      "fast-uri@<3.1.7": "3.1.7",
      "undici@<6.28.0": "6.28.0",
      "picomatch@<2.3.2": "2.3.2",
      "yaml@<2.8.3": "2.8.3",
      "ip-address@<10.3.1": "10.3.1",
      "uuid@>=11.0.0 <11.1.1": "11.1.1",
      "shell-quote@<1.9.0": "1.9.0",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "decode-uri-component@<0.5.0": "0.5.0",
      "mdx-mermaid>puppeteer": "-"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@10.30.3",
  "sherif": {
    "ignoreRule": [
      "packages-without-package-json"
    ]
  }
}
